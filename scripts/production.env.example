# Copy to the repository root as .env.production (ignored by Git).
# start.sh/start_web.sh define PROJECT_DIR before sourcing this file.
# Reuse the existing n8n instance; no management API key belongs in this file.
ENZYMIND_WORKSPACE_DB="${PROJECT_DIR}/files/workspace/workspace.sqlite3"
N8N_WORKSPACE_WEBHOOK_URL="http://127.0.0.1:5678/webhook/enzymind-workspace-v2"
ENZYMIND_AGENT_DAILY_LIMIT=10
ENZYMIND_AGENT_QUOTA_TIMEZONE=Asia/Shanghai
ENZYMIND_AGENT_DEEPSEEK_MODEL=deepseek-chat

# Optional Python Analysis. deploy.sh python_sandbox writes the private token and
# verifies the exact n8n source. First install stays disabled unless --enable-python.
ENZYMIND_PYTHON_ENABLED=false
ENZYMIND_PYTHON_RUNNER_URL=http://127.0.0.1:8091
ENZYMIND_PYTHON_AGENT_IPS=
PYTHON_SANDBOX_TOKEN=
# Only actual browser reverse proxies; this does NOT authorize Agent execution.
ENZYMIND_TRUSTED_PROXIES=

# Optional versioned Swiss-Prot BLAST bundle. Set its installed prefix on this host.
# ENZYMIND_BLAST_ARCHIVE=/srv/incoming/swissprot-20260614.tar.zst
# ENZYMIND_BLAST_RELEASE_DIR=/srv/enzymind/blast
# ENZYMIND_BLAST_DB=/srv/enzymind/blast/swissprot-20260614/uniprot
# ENZYMIND_BLAST_BIN_DIR=/usr/bin
# ENZYMIND_BLAST_THREADS=4
# ENZYMIND_BLAST_TIMEOUT=120
# ENZYMIND_BLAST_ANNOTATE=true
# Dedicated directories keep EnzyMind retention away from shared /tmp files.
# Shared 12 GiB production GPU: run folding on bounded CPU resources.
ESMFOLD_USE_GPU=false
ESMFOLD_CPU_THREADS=6
ESMFOLD_CPU_MEMORY=28g
ESMFOLD_OUTPUT_DIR="${PROJECT_DIR}/files/esmfold/output"
ESMFOLD_FASTA_DIR="${PROJECT_DIR}/files/esmfold/fasta"
STATIC_PDB_DIR="${PROJECT_DIR}/files/esmfold/pdb"
ESMFOLD_LOG_DIR="${PROJECT_DIR}/files/esmfold/output/logs"
ENZYMIND_RETENTION_ARTIFACT_ROOTS="[\"${ESMFOLD_OUTPUT_DIR}\",\"${ESMFOLD_FASTA_DIR}\",\"${STATIC_PDB_DIR}\"]"


# Exact-accession UniProt sources. Set absolute paths for this machine.
# ENZYMIND_UNIPROT_LOCAL_DB_PATH=/srv/uniprot/uniprot_full.sqlite
# ENZYMIND_UNIPROT_CACHE_PATH=/srv/enzymind/cache/uniprot.sqlite
# ENZYMIND_UNIPROT_SEQUENCE_INDEX=/srv/enzymind/blast/swissprot-20260614/uniprot
# ENZYMIND_BLAST_BIN_DIR=/usr/bin
